---
import {
  FaSolidRss,
  FaBrandsLinkedinIn,
  FaBrandsGithubAlt,
} from "solid-icons/fa";
import { SOSMED } from "@/app/static/consts";

const today = new Date();
---

<footer class="border-t mt-12 py-8">
  <div class="max-w-3xl mx-auto px-4">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <span
        class="text-sm text-gray-500 dark:text-gray-400 text-center sm:text-left"
      >
        &copy; {today.getFullYear()} Mahdy Syafiq. All rights reserved.
      </span>
      <div class="flex justify-center gap-4">
        <a
          href={SOSMED.linkedin}
          target="_blank"
          class="transition-transform hover:rotate-6"
          aria-label="Follow on Linkedin"
        >
          <FaBrandsLinkedinIn
            size={32}
            class="text-gray-800 dark:text-gray-200"
          />
        </a>
        <a
          href={SOSMED.github}
          target="_blank"
          class="transition-transform hover:rotate-6"
          aria-label="Go to GitHub repo"
        >
          <FaBrandsGithubAlt
            size={32}
            class="text-gray-800 dark:text-gray-200"
          />
        </a>
      </div>
    </div>
  </div>
</footer>
